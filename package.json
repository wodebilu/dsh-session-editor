{
  "name": "dsh-session-editor",
  "version": "0.1.0",
  "description": "Unofficial DSH plugin: delete sessions safely (trash + retention), regenerate or edit a turn, and edit your own messages.",
  "license": "MIT",
  "author": "wodebilu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wodebilu/dsh-session-toolkit.git"
  },
  "homepage": "https://github.com/wodebilu/dsh-session-toolkit#readme",
  "bugs": {
    "url": "https://github.com/wodebilu/dsh-session-toolkit/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "chat",
    "conversation"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "test/*.mjs"
  ],
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
